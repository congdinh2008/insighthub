{
  "_instructions": [
    "Thay /PATH/TO/insighthub bằng đường dẫn tuyệt đối repo InsightHub trên máy bạn.",
    "Thay đường dẫn kubeconfig bằng file kubeconfig read-only của bạn (xem infra/k8s/mcp-readonly/README.md).",
    "PROMETHEUS_URL: đổi sang URL Prometheus cluster sau khi deploy Day 3.",
    "AWS_PROFILE: IAM profile mcp-readonly tạo trước buổi (ReadOnlyAccess).",
    "KHÔNG commit file này nếu bạn hardcode credentials — dùng biến môi trường."
  ],
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/congdinh/Downloads/work/teaching/AI_for_DevOps/insighthub-solution"
      ],
      "env": {}
    },
    "kubernetes-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest",
        "--read-only"
      ],
      "env": {
        "KUBECONFIG": "/Users/congdinh/.kube/mcp-viewer.kubeconfig"
      }
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server"
      ],
      "env": {}
    },
    "prometheus": {
      "command": "npx",
      "args": [
        "-y",
        "prometheus-mcp-server@latest"
      ],
      "env": {}
    },
    "aws-api": {
