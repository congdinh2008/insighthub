{
  "__inputs": [
    {
      "name": "datasource",
      "label": "Prometheus",
      "description": "Prometheus datasource for InsightHub metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    }
  ],
  "uid": "insighthub-finops-cost",
  "title": "InsightHub LLM Cost & Token Usage",
  "description": "FinOps dashboard — LLM token consumption and estimated cost tracking (Day 6)",
  "tags": ["insighthub", "finops", "llm", "cost"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total LLM Tokens (last 24h)",
      "description": "Sum of insighthub_llm_tokens_total over the selected window",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 500000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "increase(insighthub_llm_tokens_total[24h])",
          "legendFormat": "tokens_total"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated LLM Cost (USD, last 24h)",
      "description": "Rough cost estimate: input tokens * $0.000003 + output tokens * $0.000015 (claude-sonnet-4-6 pricing). See llm_cost panel for per-hour breakdown.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(increase(insighthub_llm_tokens_total{token_type=\"input\"}[24h]) * 0.000003) + (increase(insighthub_llm_tokens_total{token_type=\"output\"}[24h]) * 0.000015)",
          "legendFormat": "llm_cost_usd"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Embedding Tokens (last 24h)",
      "description": "insighthub_embedding_tokens_total — cost of document ingestion embedding calls",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 200000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "increase(insighthub_embedding_tokens_total[24h])",
          "legendFormat": "embedding_tokens_total"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LiteLLM Budget Remaining (USD)",
      "description": "Budget remaining for the active virtual key via LiteLLM proxy (sk-insighthub-api, max 10 USD/month)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "green", "value": 5.0 }
            ]
          },
          "max": 10.0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "10.0 - ((increase(insighthub_llm_tokens_total{token_type=\"input\"}[720h]) * 0.000003) + (increase(insighthub_llm_tokens_total{token_type=\"output\"}[720h]) * 0.000015))",
          "legendFormat": "budget_remaining_usd"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM Token Rate (tokens/min)",
      "description": "Rate of insighthub_llm_tokens_total — shows query volume over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(insighthub_llm_tokens_total[5m]) * 60",
          "legendFormat": "tokens_total rate/min"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(insighthub_embedding_tokens_total[5m]) * 60",
          "legendFormat": "embedding tokens/min"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Estimated LLM Cost Rate (USD/hour)",
      "description": "Derived llm_cost per hour from token rates. Formula: input_rate*0.000003 + output_rate*0.000015, scaled to hourly.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(rate(insighthub_llm_tokens_total{token_type=\"input\"}[5m]) * 0.000003 + rate(insighthub_llm_tokens_total{token_type=\"output\"}[5m]) * 0.000015) * 3600",
          "legendFormat": "llm_cost USD/hour"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API Chat Requests / min",
      "description": "Rate of /chat requests processed — correlates with token consumption",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(insighthub_http_requests_total{endpoint=\"/chat\"}[5m])",
          "legendFormat": "chat req/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Monthly Token Budget Used (%)",
      "description": "Percentage of monthly 10 USD budget consumed by insighthub_llm_tokens_total (30-day window). Target: stay under 80%.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "clamp_max(((increase(insighthub_llm_tokens_total{token_type=\"input\"}[720h]) * 0.000003 + increase(insighthub_llm_tokens_total{token_type=\"output\"}[720h]) * 0.000015) / 10.0) * 100, 100)",
          "legendFormat": "budget_used_pct"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Avg Tokens per Chat Request",
      "description": "tokens_total / chat_requests — cost efficiency metric",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "increase(insighthub_llm_tokens_total[1h]) / clamp_min(increase(insighthub_http_requests_total{endpoint=\"/chat\"}[1h]), 1)",
          "legendFormat": "tokens_per_request"
        }
      ]
    }
  ]
}
