+"""Synthetic coding acceptance task: correct cached-input billing."""
+
+
+def cost_usd(input_tokens, output_tokens, cached_tokens):
+    # Validate types and values
+    for name, val in [('input_tokens', input_tokens), ('output_tokens', output_tokens), ('cached_tokens', cached_tokens)]:
+        if not isinstance(val, int) or isinstance(val, bool) or val < 0:
+            raise ValueError(f"{name} must be a non-negative integer and not bool")
+    if cached_tokens > input_tokens:
+        raise ValueError("cached_tokens cannot be greater than input_tokens")
+
+    # Replace input tokens with cached tokens to avoid double charging
+    billable_input = input_tokens - cached_tokens
+    return (billable_input * 0.4 + cached_tokens * 0.1 + output_tokens * 1.6) / 1_000_000
